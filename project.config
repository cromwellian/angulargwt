[project]
	description = Angular integration for GWT
[access "refs/*"]
	owner = group user/Ray Cromwell (cromwellian)
[access "refs/for/refs/*"]
	read = group user/Ray Cromwell (cromwellian)
	push = group user/Ray Cromwell (cromwellian)
	label-Code-Review = -2..+2 group user/Ray Cromwell (cromwellian)
	label-Verified = -1..+1 group user/Ray Cromwell (cromwellian)
	rebase = group user/Ray Cromwell (cromwellian)
	removeReviewer = group user/Ray Cromwell (cromwellian)
	submit = group user/Ray Cromwell (cromwellian)
[access "refs/heads/*"]
	read = group user/Ray Cromwell (cromwellian)
	create = group user/Ray Cromwell (cromwellian)
	push = +force group user/Ray Cromwell (cromwellian)
	pushMerge = group user/Ray Cromwell (cromwellian)
[access "refs/tags/*"]
	push = +force group user/Ray Cromwell (cromwellian)
	pushTag = group user/Ray Cromwell (cromwellian)
	pushSignedTag = group user/Ray Cromwell (cromwellian)
